# =========================
# Terraform files
# =========================

# Local .terraform directories
**/.terraform/*

# Terraform state files (VERY IMPORTANT)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Terraform lock info (keep this if you want reproducible builds)
# Uncomment if you want to commit it
# .terraform.lock.hcl

# Terraform plan output
*.tfplan

# Terraform CLI configuration
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# =========================
# Sensitive files
# =========================

# Variables with secrets
*.tfvars
*.tfvars.json

# Environment files
.env
.env.*

# SSH keys
*.pem
*.ppk

# =========================
# OS / Editor junk
# =========================

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# VS Code
.vscode/

# IntelliJ / JetBrains
.idea/

# Vim
*.swp
*.swo

# =========================
# Logs
# =========================
*.log

a01_Git_Push.sh

